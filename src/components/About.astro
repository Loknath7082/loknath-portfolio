---
import { about } from "../data/content.js";
---

<section id="about" class="border-t bg-card py-12">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-2xl font-medium mb-4">About</h2>
    <p class="text-lg text-foreground leading-relaxed">{about.bio}</p>
    <p class="mt-4 text-foreground">{about.mindset}</p>
    <p class="mt-4 text-sm text-muted-foreground">{about.availability}</p>
  </div>
</section>
