---
import { projects } from "../data/content.js";
---

<section id="work" class="border-t bg-card py-12">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-2xl font-medium mb-8">Work</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {projects.map((project) => (
        <article class="group rounded border border-border bg-card p-6 transition-transform duration-200 hover:scale-[1.02]">
          <div class="mb-4 h-40 bg-muted rounded" aria-hidden="true" />
          <div class="mb-2 flex items-center gap-2 text-sm text-muted-foreground">
            <span>{project.category}</span>
            <span>·</span>
            <span>{project.year}</span>
          </div>
          <h3 class="text-lg font-semibold">{project.title}</h3>
          <p class="mt-2 text-sm text-foreground">{project.problem}</p>
          <p class="mt-2 text-sm text-muted-foreground">{project.solution}</p>
          <p class="mt-2 text-sm text-foreground">{project.outcome}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {project.tech.map((t) => (
              <span class="rounded bg-muted px-2 py-0.5 text-xs text-foreground">{t}</span>
            ))}
          </div>
          <div class="mt-4 flex gap-3 text-sm">
            <a
              href={project.liveUrl}
              class="font-medium text-primary hover:underline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            >
              Live
            </a>
            <a
              href={project.repoUrl}
              class="font-medium text-foreground hover:underline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
              aria-label={`${project.title} source`}
            >
              Source
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
