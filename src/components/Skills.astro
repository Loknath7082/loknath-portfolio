---
import { techCapabilities } from "../data/content.js";
---

<section id="stack" class="border-t bg-card py-12">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-2xl font-medium mb-8">Tech Capabilities</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {techCapabilities.map((col) => (
        <div class="rounded border border-border bg-card p-6">
          <h3 class="mb-3 font-medium">{col.column}</h3>
          <ul class="flex flex-wrap gap-2">
            {col.items.map((item) => (
              <li class="rounded bg-muted px-2 py-0.5 text-xs text-foreground">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
