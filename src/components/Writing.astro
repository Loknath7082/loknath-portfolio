---
import { articles } from "../data/content.js";
---

<section id="writing" class="border-t bg-card py-12">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-2xl font-medium mb-8 reveal">Technical Writing</h2>
    <ul class="grid gap-6 md:grid-cols-2">
      {articles.map((article) => (
        <li class="reveal rounded border border-border bg-card p-6">
          <div class="mb-2 flex items-center gap-2 text-sm text-muted-foreground">
            <span aria-hidden="true">{article.platform}</span>
            <span>·</span>
            <span>{article.readTime} read</span>
          </div>
          <h3 class="text-lg font-semibold">
            <a
              href={article.url}
              class="hover:underline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            >
              {article.title}
            </a>
          </h3>
          <p class="mt-2 text-sm text-foreground">{article.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
