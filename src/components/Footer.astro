---

<footer class="border-t bg-card mt-16">
  <div class="mx-auto max-w-5xl p-6">
    <div class="flex flex-col items-center gap-4 text-sm text-muted-foreground">
      <ul class="flex flex-wrap items-center gap-4">
        {socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              rel="me noopener"
              aria-label={link.label}
              class="inline-flex items-center rounded border border-border bg-card px-2 py-1 text-foreground focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 hover:bg-muted"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={link.icon} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
      <p class="text-center">
        &copy; {new Date().getFullYear()} Loknath Patel. All rights reserved.
      </p>
    </div>
  </div>
</footer>
