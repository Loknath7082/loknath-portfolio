---
import '../styles/theme.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Loknath Patel — Full-Stack Developer</title>
    <meta name="description" content="Full-Stack Developer based in India." />
    <script>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored) {
            document.documentElement.setAttribute("data-theme", stored);
            return;
          }
        } catch (e) {}
        var prefersLight = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches;
        document.documentElement.setAttribute("data-theme", prefersLight ? "light" : "dark");
      })();
    </script>
  </head>    <body class="font-sans">
      <header class="p-6 border-b">
        <nav class="flex gap-6 items-center">
          <span class="font-mono text-sm text-muted-foreground">portfolio</span>
          <a class="font-sans font-medium text-primary" href="#work">Work</a>
          <a class="font-sans font-medium text-foreground" href="#contact">Contact</a>
        </nav>
      </header>
      <main class="max-w-3xl mx-auto p-6">
        <section id="work" class="space-y-4">
          <h1 class="text-4xl font-medium tracking-tight">Loknath Patel</h1>
          <p class="text-lg text-foreground">Full-Stack Developer based in India.</p>
          <pre class="font-mono text-sm bg-muted p-4 rounded border text-foreground">const who = "Loknath Patel";
console.log(who);
// Full-Stack Developer, India</pre>
        </section>
      </main>
    </body>
</html>
