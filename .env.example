# Environment variables for Loknath Patel portfolio

# Resend API key — used by the contact form (src/pages/api/contact.js).
# Get one at https://resend.com
RESEND_API_KEY=

# Email address that receives contact form submissions.
CONTACT_TO_EMAIL=

# Public URL of the deployed site. Drives JSON-LD, OG tags, robots.txt,
# and the sitemap. Defaults to https://example.com if unset.
PUBLIC_SITE_URL=https://example.com
